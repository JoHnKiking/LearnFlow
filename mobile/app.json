{
  "expo": {
    "name": "LearnFlow v1.0",
    "slug": "learnflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.jpg",
    "scheme": "learnflow",
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.jpg",
        "backgroundColor": "#ffffff"
      },
      "package": "com.johnkiwu.learnflow"
    },
    "web": {},
    "extra": {
      "apiBaseUrl": "https://heterotrichous-gerty-catadromous.ngrok-free.dev/api",
      "eas": {
        "projectId": "a4114c63-9fd5-43d7-9771-accfb461b82c"
      }
    }
  }
}
